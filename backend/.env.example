# ── 基础配置 ──
DEBUG=false
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Redis 配置 ──
# Docker Compose 会覆盖为 redis queue/cache 两个服务地址；本地运行时可按需设置。
# REDIS_QUEUE_URL=redis://localhost:6379/0
# REDIS_CACHE_URL=redis://localhost:6379/0
# MASTER_BANK_CACHE_TTL_SECONDS=15

# ── LLM 配置 ──
OPENAI_API_KEY=your_api_key_here
# 如果你使用的是代理或者其他兼容 OpenAI 格式的模型（如国内的某些大模型），可以配置 BASE_URL
# OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o
# LLM_TIMEOUT=120

# ── 认证配置 ──
# JWT_SECRET 无需手动设置：留空时系统自动生成强随机密钥并写回 .env（backend/app/core/auth.py）。
# 禁止填写固定的占位字符串，否则所有照抄示例的部署将共享同一签名密钥（tech-audit-2026-08-13 D13-1）。
# JWT_SECRET=
# OAuth 连接器签名密钥（必须设置为每个部署独立的随机值）
# OAUTH_SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_strong_password

# ── External MCP ──
# 可选：当站点位于反向代理、端口映射或隧道后时，设置为外部 agent 实际访问的地址。
# MCP_PUBLIC_URL=http://your-host.example.com/mcp
# MCP_ALLOW_ANONYMOUS=false

# ── 文件上传限制 ──
# MAX_FILE_SIZE_MB=10
# MAX_TOTAL_UPLOAD_SIZE_MB=50

# ── Embedding 配置 ──
# EMBEDDING_BACKEND=onnx
# EMBEDDING_MODEL_DIR=/app/models/bge-small-zh-v1.5
# EMBEDDING_OFFLINE=1

# ── SMTP 邮箱配置（邮箱验证码功能）──
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USERNAME=your_email@qq.com
# SMTP_PASSWORD=your_authorization_code
# SMTP_FROM=your_email@qq.com
# SMTP_FROM_NAME=InterviewBoss
# SMTP_USE_TLS=true
