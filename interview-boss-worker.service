[Unit]
Description=InterviewBoss ARQ Worker
After=network.target redis.service

[Service]
Type=simple
WorkingDirectory=/root/sj/interview-boss/backend
ExecStart=/root/sj/interview-boss/.venv/bin/arq app.worker.WorkerSettings
Restart=always
RestartSec=10
Environment=PYTHONPATH=/root/sj/interview-boss/backend
Environment=REDIS_URL=redis://localhost:6379/0

# 2c4g 资源限制
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
