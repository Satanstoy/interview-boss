#!/bin/bash
# Conventional Commits commit-msg hook
# 与 CLAUDE.md 提交规范一致：feat(frontend): / fix(backend): 等，英文。
# 安装：git config core.hooksPath .githooks
set -u

msg_file="$1"
first_line=$(head -1 "$msg_file")

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9_-]+\))?!?: .+$'

if ! printf '%s' "$first_line" | grep -qE "$pattern"; then
  echo "✗ commit message 不符合 Conventional Commits 规范" >&2
  echo "  格式: <type>(<scope>): <subject>" >&2
  echo "  例:   feat(frontend): add answer sources display" >&2
  echo "        fix(backend): replace pypdf with pdfplumber" >&2
  echo "  当前: $first_line" >&2
  exit 1
fi

if [ "$(wc -c < "$msg_file")" -eq 0 ]; then
  echo "✗ commit message 为空" >&2
  exit 1
fi

exit 0
